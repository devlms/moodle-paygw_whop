{{!
    @template paygw_whop/pay

    The price and one button to Whop's checkout page.

    Example context (json):
    {
        "description": "Enrolment in Introduction to Physics", "cost": "USD 49.00",
        "action": "#", "sesskey": "x", "hidden": [{"name": "itemid", "value": "3"}]
    }
}}
<div class="paygw-whop">
    <p class="paygw-whop-what">{{description}}</p>
    <p class="paygw-whop-cost">{{cost}}</p>
    <form method="post" action="{{action}}">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <input type="hidden" name="go" value="1">
        {{#hidden}}<input type="hidden" name="{{name}}" value="{{value}}">{{/hidden}}
        <button type="submit" class="btn btn-primary">{{#str}}continue, paygw_whop{{/str}}</button>
    </form>
    <p class="paygw-whop-note">{{#str}}redirectnote, paygw_whop{{/str}}</p>
</div>
